{
  "expo": {
    "name": "Punch Desk",
    "slug": "punch-desk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/punch-desk-logo.png",
    "scheme": "punchdesk",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.gaydatingengine.p0n5wm",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show people nearby.",
        "NSUserNotificationsUsageDescription": "Stay close to new connections.",
        "NSPhotoLibraryUsageDescription": "Add photos to your profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/punch-desk-logo.png",
        "backgroundColor": "#0C0D10"
      },
      "package": "com.emergent.gaydatingengine.p0n5wm",
      "googleServicesFile": "./google-services.json",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/punch-desk-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
        "backgroundColor": "#0C0D10"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}